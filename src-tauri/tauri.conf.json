{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulk",
  "version": "0.1.0",
  "identifier": "io.github.funkyscientist.bulk",
  "build": {
    "beforeDevCommand": "pnpm dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bulk",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bulk",
    "shortDescription": "See what's using your disk space",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer/hooks.nsh"
      }
    }
  }
}
